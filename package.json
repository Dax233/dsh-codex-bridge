{
  "name": "@local/dsh-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex bridge for DeepSeek Harness: inspect local Codex threads, dispatch tasks to them, read their transcripts, watch goal state and liveness, and drive headless Codex turns through the subprocess seam.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/unit.test.mjs",
    "smoke": "node tests/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dax233/dsh-codex-bridge.git"
  },
  "homepage": "https://github.com/Dax233/dsh-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/Dax233/dsh-codex-bridge/issues"
  }
}
